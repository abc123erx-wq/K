# ═══════════════════════════════════════════════════════════════
#  EXEMPLO DE VARIÁVEIS DE AMBIENTE
#
#  Copie este arquivo para `.env` (que está no .gitignore) e
#  preencha com os valores reais. NUNCA versione o `.env`.
#
#  Nenhum segredo deve ser escrito dentro de `src/`, `server/*.mjs`
#  versionado ou no bundle gerado (`dist/index.html`).
# ═══════════════════════════════════════════════════════════════

# ── Servidor de.multiplayer (server/ws-server.mjs) ─────────────

# Porta do servidor WebSocket / HTTP.
PORT=8080

# Force HTTPS (redireciona HTTP → HTTPS).
# Ative em produção. Em desenvolvimento local, deixe desligado.
FORCE_HTTPS=0

# Origem autorizada para CORS (ex.: https://seu-dominio.com).
# Vazio = somente same-origin.
ALLOWED_ORIGIN=

# ── Painel especial / administração ─────────────────────────────
# IDs das contas autorizadas (separados por vírgula).
# Descubra o id em "Configurações → Conta" dentro do jogo.
ADMIN_ACCOUNT_IDS=usr_rimu,usr_guis

# Vínculo opcional nome de exibição → id da conta (JSON).
# O nome precisa mapear EXATAMENTE para o mesmo id.
ADMIN_ACCOUNT_NAMES={"RimuOfc":"usr_rimu","Guisdfas":"usr_guis"}

# Alternativa: arquivo JSON com a lista de ids.
# ADMIN_ACCOUNTS_FILE=./admin-accounts.json

# Limites do painel (opcionais — os padrões são estes).
# PANEL_COMMAND_COOLDOWN_MS=3000
# PANEL_ACTIVATION_COOLDOWN_MS=5000
# PANEL_MAX_COMMANDS_PER_WINDOW=10
# PANEL_COMMAND_WINDOW_MS=60000
# PANEL_MAX_ACTIVE_EFFECTS_PER_ROOM=30
# PANEL_MAX_ACTIVE_EFFECTS_PER_TARGET=6
# ADMIN_SESSION_TTL_MS=1800000

# ── Cobrança (server/paddle-server.mjs) ─────────────────────────
# NENHUMA chave secreta é versionada. Configure no ambiente.
# PADDLE_API_KEY=
# PADDLE_API_KEY_ALT=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENVIRONMENT=sandbox

# ── Front-end (expostas no bundle por nature) ──────────────────
# Token público do Paddle (público por design).
# VITE_PADDLE_CLIENT_TOKEN=
# URL do servidor de cobrança.
# VITE_PADDLE_SERVER=https://billing.seudominio.com
# URL do servidor de multiplayer.
# VITE_GAME_SERVER_URL=wss://seu-dominio.com
